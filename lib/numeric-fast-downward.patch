+++ b/src/search/lp/OsiIPCpxSolverInterface.cc
@@ -1,5 +1,5 @@
 #include "OsiIPCpxSolverInterface.h"
-#ifdef USE_LP
+#if defined(USE_LP) && defined(COIN_HAS_CPX)
 
