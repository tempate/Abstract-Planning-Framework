+shared_ptr<Group> LazySearch::prepare_symmetries(const plugins::Options &opts) {
+    if (!opts.contains("symmetries"))
+        return nullptr;
+    shared_ptr<Group> symmetries = opts.get<shared_ptr<Group>>("symmetries");
+    if (!symmetries->is_initialized()) {
+        utils::g_log << "Initializing symmetries (lazy search)" << endl;
+        symmetries->compute_symmetries(TaskProxy(*tasks::g_root_task));
+    }
+    if (!symmetries->has_symmetries())
+        return nullptr;
+    /*
+      Duplicate pruning registers every state as generated and only drops one
+      symmetric to a state seen before, so path-dependent evaluators such as the
+      landmark heuristic see real transitions. Orbit space search would replace
+      each successor by its canonical representative and leave their per-state
+      information describing another state.
+
+      The registry pairs each state with its canonical representative from the
+      first state on, so it has to know the group before it registers the
+      initial state.
+    */
+    utils::g_log << "Setting group in registry for DKS search" << endl;
+    state_registry.set_group(symmetries);
+    return symmetries;
+}
