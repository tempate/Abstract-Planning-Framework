+// Reads the generators from search_generators.txt instead of computing them, one per line as
+// the images of the variables followed by those of the values, in the order the graph creator numbers them.
+void Group::read_generators(const TaskProxy &task_proxy) {
+    VariablesProxy vars = task_proxy.get_variables();
+    int length = vars.size();
+    for (VariableProxy var : vars) {
+        add_to_dom_sum_by_var(length);
+        length += var.get_domain_size();
+        for (int value = 0; value < var.get_domain_size(); ++value) {
+            add_to_var_by_val(var.get_id());
+        }
+    }
+    set_permutation_num_variables(vars.size());
+    set_permutation_length(length);
+    set_graph_size(length);
+
+    ifstream file("search_generators.txt");
+    if (!file) {
+        cerr << "Cannot open search_generators.txt" << endl;
+        exit_with(ExitCode::SEARCH_CRITICAL_ERROR);
+    }
+    string line;
+    while (getline(file, line)) {
+        istringstream images(line);
+        vector<unsigned int> generator;
+        unsigned int image;
+        while (images >> image) {
+            generator.push_back(image);
+        }
+        if (generator.empty()) {
+            continue;
+        }
+        if (static_cast<int>(generator.size()) != length) {
+            cerr << "A generator has " << generator.size() << " images instead of " << length << endl;
+            exit_with(ExitCode::SEARCH_CRITICAL_ERROR);
+        }
+        add_raw_generator(generator.data());
+    }
+    utils::g_log << "Read " << get_num_generators() << " generators" << endl;
+}
